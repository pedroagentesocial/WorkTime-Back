generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum CompanyStatus {
  active
  suspended

  @@map("company_status")
}

enum UserRole {
  platform_admin
  company_admin
  multi_company_admin
  employee

  @@map("user_role")
}

enum UserStatus {
  active
  inactive

  @@map("user_status")
}

enum TimeEntrySource {
  web
  admin

  @@map("time_entry_source")
}

enum TimeEntryCloseSource {
  employee
  admin
  daily_limit

  @@map("time_entry_close_source")
}

model Company {
  id                       String        @id @default(uuid(7)) @db.Uuid
  code                     String        @unique @db.VarChar(9)
  employeeCodePrefix       String        @unique @map("employee_code_prefix") @db.Char(3)
  /// Ultimo numero consecutivo de empleado usado; solo sube, asi un numero no se reutiliza
  employeeSequence         Int           @default(0) @map("employee_sequence")
  name                     String        @db.VarChar(150)
  timezone                 String        @db.VarChar(64)
  maxEmployees             Int           @map("max_employees")
  dailyLimitMinutes        Int?          @map("daily_limit_minutes")
  requireDailyReport       Boolean       @default(true) @map("require_daily_report")
  /// Si es true, solo se puede marcar la entrada dentro de una zona de trabajo activa
  enforceWorkSites         Boolean       @default(false) @map("enforce_work_sites")
  /// Si es true, los empleados pueden registrar su llegada a un lugar sin marcar entrada
  allowCheckIns            Boolean       @default(false) @map("allow_check_ins")
  /// Moneda ISO 4217 en la que cobran todos sus empleados
  currency                 String        @default("USD") @db.Char(3)
  /// Cuantos dias hacia atras pueden corregir sus horas los empleados con permiso
  selfEditDays             Int           @default(7) @map("self_edit_days")
  dailyReportRequiredSince DateTime      @default(dbgenerated("CURRENT_DATE")) @map("daily_report_required_since") @db.Date
  status                   CompanyStatus @default(active)
  createdAt                DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  users                User[]
  employees            Employee[]
  timeEntries          TimeEntry[]
  corrections          TimeEntryCorrection[]
  securityEvents       SecurityEvent[]
  dailyReports         DailyReport[]
  dailyReportRevisions DailyReportRevision[]
  payPeriodClosures    PayPeriodClosure[]
  workSites            WorkSite[]
  checkIns             CheckIn[]
  payRates             EmployeePayRate[]
  closurePays          PayPeriodClosurePay[]
  memberships          CompanyMembership[]
  refreshTokens        RefreshToken[]

  @@index([status])
  @@map("companies")
}

model User {
  id                         String     @id @default(uuid(7)) @db.Uuid
  companyId                  String?    @map("company_id") @db.Uuid
  email                      String     @unique @db.VarChar(254)
  passwordHash               String     @map("password_hash") @db.Text
  role                       UserRole
  status                     UserStatus @default(active)
  firstName                  String     @map("first_name") @db.VarChar(100)
  lastName                   String     @map("last_name") @db.VarChar(100)
  mustChangePassword         Boolean    @default(false) @map("must_change_password")
  temporaryPasswordExpiresAt DateTime?  @map("temporary_password_expires_at") @db.Timestamptz(3)
  tokenVersion               Int        @default(0) @map("token_version")
  failedLoginAttempts        Int        @default(0) @map("failed_login_attempts")
  lockedUntil                DateTime?  @map("locked_until") @db.Timestamptz(3)
  lockLevel                  Int        @default(0) @map("lock_level")
  passwordChangedAt          DateTime?  @map("password_changed_at") @db.Timestamptz(3)
  lastLoginAt                DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt                  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  company           Company?              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee          Employee?
  refreshTokens     RefreshToken[]
  passwordResets    PasswordResetToken[]
  multiCompanyAdmin MultiCompanyAdmin?
  memberships       CompanyMembership[]
  corrections       TimeEntryCorrection[]
  voidedEntries     TimeEntry[]           @relation("TimeEntryVoidedBy")
  voidedCheckIns    CheckIn[]             @relation("CheckInVoidedBy")
  changedPayRates   EmployeePayRate[]     @relation("PayRateChangedBy")
  closedPeriods     PayPeriodClosure[]
  securityEvents    SecurityEvent[]

  /// Un solo admin por empresa
  @@unique([companyId], map: "users_one_company_admin_per_company", where: raw("role = 'company_admin'"))
  /// Permite referencias compuestas que garantizan la misma empresa
  @@unique([companyId, id])
  @@index([companyId, role, status])
  @@map("users")
}

/// Enlace de un solo uso para recuperar la contrasena por correo; se guarda solo el hash del token
model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  ip        String?   @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("password_reset_tokens")
}

model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  tokenVersion Int       @map("token_version")
  /// Empresa activa de la sesion de un admin multiempresa; null para el resto
  companyId    String?   @map("company_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  ip           String?   @db.VarChar(45)
  userAgent    String?   @map("user_agent") @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Limites del paquete de un admin multiempresa; los fija solo el admin global
model MultiCompanyAdmin {
  userId                 String   @id @map("user_id") @db.Uuid
  maxCompanies           Int      @map("max_companies")
  maxEmployeesPerCompany Int      @map("max_employees_per_company")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("multi_company_admins")
}

/// Empresas a las que un admin multiempresa tiene acceso; quitar la fila quita el acceso
model CompanyMembership {
  userId    String   @map("user_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@id([userId, companyId])
  @@index([companyId])
  @@map("company_memberships")
}

model SecurityEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  type      String   @db.VarChar(64)
  userId    String?  @map("user_id") @db.Uuid
  companyId String?  @map("company_id") @db.Uuid
  ip        String?  @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(255)
  metadata  Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User?    @relation(fields: [userId], references: [id], onDelete: Restrict)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("security_events")
}

model Employee {
  id                String    @id @default(uuid(7)) @db.Uuid
  companyId         String    @map("company_id") @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  employeeCode      String    @map("employee_code") @db.VarChar(50)
  phone             String?   @db.VarChar(30)
  timezone          String?   @db.VarChar(64)
  dailyLimitMinutes Int?      @map("daily_limit_minutes")
  /// Check-in propio: null hereda el de la empresa, true lo permite y false lo prohibe
  allowCheckIns     Boolean?  @map("allow_check_ins")
  /// Permiso del admin para que corrija sus propias horas; selfEditUntil es el ultimo dia, null sin vencimiento
  allowSelfEdit     Boolean   @default(false) @map("allow_self_edit")
  selfEditUntil     DateTime? @map("self_edit_until") @db.Date
  hiredAt           DateTime? @map("hired_at") @db.Date
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company       Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user          User                   @relation(fields: [companyId, userId], references: [companyId, id], onDelete: Restrict)
  timeEntries   TimeEntry[]
  dailyReports  DailyReport[]
  checkIns      CheckIn[]
  payRates      EmployeePayRate[]
  closurePays   PayPeriodClosurePay[]
  inactiveSpans EmployeeInactiveSpan[]

  @@unique([companyId, employeeCode])
  @@unique([companyId, userId])
  @@unique([companyId, id])
  @@index([companyId])
  @@map("employees")
}

model TimeEntry {
  id               String                @id @default(uuid(7)) @db.Uuid
  companyId        String                @map("company_id") @db.Uuid
  employeeId       String                @map("employee_id") @db.Uuid
  clockInAt        DateTime              @map("clock_in_at") @db.Timestamptz(3)
  clockOutAt       DateTime?             @map("clock_out_at") @db.Timestamptz(3)
  timezone         String                @db.VarChar(64)
  workDate         DateTime              @map("work_date") @db.Date
  source           TimeEntrySource
  closeSource      TimeEntryCloseSource? @map("close_source")
  dailyLimitWaived Boolean               @default(false) @map("daily_limit_waived")
  createdReason    String?               @map("created_reason") @db.VarChar(500)
  /// Donde estaba el empleado al marcar la entrada; las tres columnas van juntas o ninguna
  clockInLatitude  Float?                @map("clock_in_latitude")
  clockInLongitude Float?                @map("clock_in_longitude")
  clockInAccuracyM Float?                @map("clock_in_accuracy_m")
  /// Resultado de la zona al marcar: inside u outside, la zona mas cercana y a cuantos metros
  clockInZone      String?               @map("clock_in_zone") @db.VarChar(10)
  clockInSiteId    String?               @map("clock_in_site_id") @db.Uuid
  clockInDistanceM Int?                  @map("clock_in_distance_m")
  /// Anulacion: el registro no se borra, deja de contar. Los tres campos van juntos
  voidedAt         DateTime?             @map("voided_at") @db.Timestamptz(3)
  voidedById       String?               @map("voided_by_id") @db.Uuid
  voidReason       String?               @map("void_reason") @db.VarChar(500)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  voidedBy    User?                 @relation("TimeEntryVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  company     Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee    Employee              @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)
  clockInSite WorkSite?             @relation(fields: [companyId, clockInSiteId], references: [companyId, id], onDelete: Restrict)
  corrections TimeEntryCorrection[]

  /// Evita dos entradas abiertas por doble clic o concurrencia
  @@unique([employeeId], map: "time_entries_one_open_per_employee", where: raw("clock_out_at IS NULL AND voided_at IS NULL"))
  @@unique([companyId, id])
  @@index([companyId, clockInAt(sort: Desc)])
  @@index([employeeId, clockInAt(sort: Desc)])
  @@index([companyId, workDate])
  @@index([employeeId, workDate])
  @@map("time_entries")
}

/// Zona de trabajo: un punto con radio donde se permite marcar la entrada. Se desactiva, no se borra
model WorkSite {
  id        String   @id @default(uuid(7)) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String   @db.VarChar(100)
  latitude  Float
  longitude Float
  radiusM   Int      @map("radius_m")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  timeEntries TimeEntry[]
  checkIns    CheckIn[]

  @@unique([companyId, id])
  @@index([companyId, active])
  @@map("work_sites")
}

/// Registro de llegada a un lugar: hora y ubicacion sin marcar entrada. No cuenta horas.
/// Solo se crea; el admin lo puede anular sin borrarlo
model CheckIn {
  id          String    @id @default(uuid(7)) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  employeeId  String    @map("employee_id") @db.Uuid
  checkedInAt DateTime  @map("checked_in_at") @db.Timestamptz(3)
  timezone    String    @db.VarChar(64)
  workDate    DateTime  @map("work_date") @db.Date
  latitude    Float
  longitude   Float
  accuracyM   Float     @map("accuracy_m")
  /// Resultado de la zona al registrar: inside u outside, la zona mas cercana y a cuantos metros
  zone        String?   @db.VarChar(10)
  siteId      String?   @map("site_id") @db.Uuid
  distanceM   Int?      @map("distance_m")
  note        String?   @db.VarChar(200)
  /// Anulacion: no se borra, deja de verse. Los tres campos van juntos
  voidedAt    DateTime? @map("voided_at") @db.Timestamptz(3)
  voidedById  String?   @map("voided_by_id") @db.Uuid
  voidReason  String?   @map("void_reason") @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee Employee  @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)
  site     WorkSite? @relation(fields: [companyId, siteId], references: [companyId, id], onDelete: Restrict)
  /// Sin empresa en la llave: quien anula puede ser un admin multiempresa, que no tiene empresa propia
  voidedBy User?     @relation("CheckInVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)

  @@unique([companyId, id])
  @@index([companyId, checkedInAt(sort: Desc)])
  @@index([employeeId, checkedInAt(sort: Desc)])
  @@index([employeeId, workDate])
  @@map("check_ins")
}

/// Periodo de pago cerrado: sus horas quedan congeladas y no se reabre
model PayPeriodClosure {
  id              String   @id @default(uuid(7)) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  periodStart     DateTime @map("period_start") @db.Date
  periodEnd       DateTime @map("period_end") @db.Date
  totalCentihours BigInt   @map("total_centihours")
  closedById      String   @map("closed_by_id") @db.Uuid
  closedAt        DateTime @default(now()) @map("closed_at") @db.Timestamptz(3)
  /// Moneda de los pagos congelados; null en los cierres anteriores a los sueldos
  currency        String?  @db.Char(3)

  company  Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  closedBy User                  @relation(fields: [closedById], references: [id], onDelete: Restrict)
  pays     PayPeriodClosurePay[]

  @@unique([companyId, periodStart])
  @@unique([companyId, id])
  @@map("pay_period_closures")
}

/// Historial de sueldo: cada fila rige desde su fecha hasta la siguiente. Solo uno por dia
model EmployeePayRate {
  id            String   @id @default(uuid(7)) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  employeeId    String   @map("employee_id") @db.Uuid
  /// hourly: amountCents es por hora; salary: es el sueldo fijo de cada periodo de 14 dias
  kind          String   @db.VarChar(10)
  amountCents   BigInt   @map("amount_cents")
  effectiveFrom DateTime @map("effective_from") @db.Date
  changedById   String   @map("changed_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee  Employee @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)
  changedBy User     @relation("PayRateChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@unique([employeeId, effectiveFrom])
  @@index([companyId])
  @@map("employee_pay_rates")
}

/// Pago de cada empleado congelado al cerrar el periodo
model PayPeriodClosurePay {
  closureId   String @map("closure_id") @db.Uuid
  companyId   String @map("company_id") @db.Uuid
  employeeId  String @map("employee_id") @db.Uuid
  amountCents BigInt @map("amount_cents")

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  closure  PayPeriodClosure @relation(fields: [companyId, closureId], references: [companyId, id], onDelete: Restrict)
  employee Employee         @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)

  @@id([closureId, employeeId])
  @@map("pay_period_closure_pays")
}

model TimeEntryCorrection {
  id                 String    @id @default(uuid(7)) @db.Uuid
  companyId          String    @map("company_id") @db.Uuid
  timeEntryId        String    @map("time_entry_id") @db.Uuid
  correctedById      String    @map("corrected_by_id") @db.Uuid
  previousClockInAt  DateTime  @map("previous_clock_in_at") @db.Timestamptz(3)
  previousClockOutAt DateTime? @map("previous_clock_out_at") @db.Timestamptz(3)
  newClockInAt       DateTime  @map("new_clock_in_at") @db.Timestamptz(3)
  newClockOutAt      DateTime? @map("new_clock_out_at") @db.Timestamptz(3)
  reason             String    @db.VarChar(500)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  company     Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  timeEntry   TimeEntry @relation(fields: [companyId, timeEntryId], references: [companyId, id], onDelete: Restrict)
  correctedBy User      @relation(fields: [correctedById], references: [id], onDelete: Restrict)

  @@index([timeEntryId, createdAt(sort: Desc)])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("time_entry_corrections")
}

model DailyReport {
  id         String   @id @default(uuid(7)) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  workDate   DateTime @map("work_date") @db.Date
  content    String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company   Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee  Employee              @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)
  revisions DailyReportRevision[]

  @@unique([employeeId, workDate])
  @@unique([companyId, id])
  @@index([companyId, workDate])
  @@map("daily_reports")
}

model DailyReportRevision {
  id        String   @id @default(uuid(7)) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  reportId  String   @map("report_id") @db.Uuid
  content   String   @db.Text
  savedAt   DateTime @default(now()) @map("saved_at") @db.Timestamptz(3)

  company Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  report  DailyReport @relation(fields: [companyId, reportId], references: [companyId, id], onDelete: Restrict)

  @@index([reportId, savedAt(sort: Desc)])
  @@map("daily_report_revisions")
}

/// Bajas del empleado: dias en que no cobra sueldo fijo. to_day null mientras sigue inactivo
model EmployeeInactiveSpan {
  companyId  String    @map("company_id") @db.Uuid
  employeeId String    @map("employee_id") @db.Uuid
  fromDay    DateTime  @map("from_day") @db.Date
  toDay      DateTime? @map("to_day") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)

  @@id([employeeId, fromDay])
  @@unique([employeeId], map: "employee_inactive_spans_one_open", where: raw("to_day IS NULL"))
  @@index([companyId])
  @@map("employee_inactive_spans")
}

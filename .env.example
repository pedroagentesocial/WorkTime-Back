# Plantilla del .env: copiala como .env y cambia los valores. Nunca subas el .env al repositorio.

# development, test o production (obligatoria)
NODE_ENV=development
# Puerto de la API
PORT=3000
# Proxies delante de la API (Tailscale, Caddy, nginx); 0 si nadie esta delante
TRUST_PROXY_HOPS=0
# Origenes del front permitidos, separados por coma
CORS_ORIGINS=http://localhost:4200

# Base de datos de desarrollo; los tests usan la misma con _test al final del nombre
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/worktime

# Secreto de los tokens: minimo 64 caracteres aleatorios. Se rechazan los valores de ejemplo como este
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=genera-un-secreto-aleatorio
# Duracion del access token (5m a 1h) y del refresh token (1d a 30d)
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=7d

# Admin global que crea el seed si no existe; al entrar debe cambiar la contrasena
SEED_ADMIN_EMAIL=admin@tudominio.com
SEED_ADMIN_PASSWORD=cambia-esta-contrasena

# Correos con Resend (aun no los usa la API: se programaran despues)
# Llave de la cuenta de Resend
RESEND_API_KEY=re_reemplaza_con_tu_llave_de_resend
# Remitente: debe ser del dominio verificado en esa cuenta de Resend
EMAIL_FROM="WorkTime <no-responder@tudominio.com>"
# Direccion del front a la que apuntan los enlaces de los correos
APP_URL=https://localhost:4200

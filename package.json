{
  "name": "worktime-back",
  "version": "0.1.0",
  "description": "WorkTime API - control de asistencia multiempresa",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#config/*": {
      "development": "./src/config/*",
      "default": "./dist/config/*"
    },
    "#shared/*": {
      "development": "./src/shared/*",
      "default": "./dist/shared/*"
    },
    "#modules/*": {
      "development": "./src/modules/*",
      "default": "./dist/modules/*"
    },
    "#generated/*": {
      "development": "./src/generated/*",
      "default": "./dist/generated/*"
    }
  },
  "scripts": {
    "dev": "tsx watch --conditions=development --clear-screen=false src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:watch": "vitest --project unit",
    "test:cov": "vitest run --coverage",
    "docs:api": "tsx --conditions=development scripts/build-api-docs.ts",
    "check": "npm run typecheck && npm run lint && npm run test:unit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "admin:recover": "tsx --conditions=development src/cli/recover-platform-admin.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "awilix": "13.0.5",
    "cors": "2.8.6",
    "dotenv": "18.0.4",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "swagger-ui-express": "5.0.1",
    "uuid": "14.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-security": "4.1.0",
    "globals": "17.12.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5"
  }
}
